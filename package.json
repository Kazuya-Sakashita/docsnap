    "typescript": "^5",
    "typescript-eslint": "^8.46.3"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,js,jsx}": [
      "eslint --fix"
    ],
    "*.{json,md,css,scss}": [
      "prettier --write"
    ],
    "prisma/**/*.prisma": [
