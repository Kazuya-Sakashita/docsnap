// Prisma Schema for DocSnap
// レシート・領収書管理アプリのデータベーススキーマ

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =================== Enums ===================
enum AccountType {
  PERSONAL
  BUSINESS
}

enum ReceiptType {
  RECEIPT
  INVOICE
}

enum ReceiptStatus {
  DRAFT
  READY
  PROCESSING
  ERROR
  DUPLICATE
}

enum Currency {
  JPY
  USD
  EUR
  OTHER
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  OTHER
}

// persist.ts が期待する OCR エンジン種別
enum OcrEngine {
  TESSERACT
  GOOGLE_DOC_AI
  AWS_TEXTRACT
  AZURE_FORM_RECOGNIZER
  OTHER
}

// =================== Models ===================

// ユーザー
model User {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supabaseUserId String      @unique // ★ 追加（必須）
  email          String      @unique
  name           String?
  accountType    AccountType @default(PERSONAL)
  companyName    String?
  createdAt      DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(6)
  deletedAt      DateTime?   @db.Timestamptz(6)

  receipts   Receipt[]
  categories Category[]

  @@map("users")
}

// レシート/領収書
model Receipt {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String        @db.Uuid
  type         ReceiptType   @default(RECEIPT)
  title        String
  storeName    String
  purchaseDate DateTime      @db.Timestamptz(6)
  currency     Currency      @default(JPY)
  subtotal     Decimal       @db.Decimal(14, 2)
  tax          Decimal       @db.Decimal(14, 2)
  total        Decimal       @db.Decimal(14, 2)
  memo         String?       @db.Text
  status       ReceiptStatus @default(READY)

  // OCR関連（既存）
  confidenceScore Float?
  imageUrl        String?
  ocrData         Json?

  // 解析メタ（persist.ts が利用）
  rawOcrText       String
  normalizedJson   Json
  taxBreakdownJson Json?
  parser           String?
  parseVersion     String?
  ocrEngine        OcrEngine? // ← 追加

  // 重複検知
  fingerprint     String // ← 追加（テキスト指紋）
  isDuplicateOfId String?   @db.Uuid
  isDuplicateOf   Receipt?  @relation("DuplicateOf", fields: [isDuplicateOfId], references: [id])
  duplicates      Receipt[] @relation("DuplicateOf")

  // カテゴリ
  categoryId String? @db.Uuid

  // 領収書固有フィールド
  invoiceNumber      String?
  recipientName      String?
  purpose            String?
  registrationNumber String?
  issuerAddress      String?
  paymentDueDate     DateTime?      @db.Timestamptz(6)
  paymentMethod      PaymentMethod?
  taxRate            Decimal?       @db.Decimal(5, 2)

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  items    ReceiptItem[]
  files    ReceiptFile[] // ← 追加（ファイル添付）

  @@unique([userId, fingerprint]) // ← ユーザー内で指紋ユニーク
  @@index([userId])
  @@index([categoryId])
  @@index([purchaseDate])
  @@index([status])
  @@map("receipts")
}

// 明細（Decimal を null 許容、追加メタ rawLine / taxRate）
model ReceiptItem {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  receiptId String   @db.Uuid
  name      String
  quantity  Int      @default(1)
  unitPrice Decimal? @db.Decimal(14, 2) // ← null 許容
  amount    Decimal? @db.Decimal(14, 2) // ← null 許容
  taxRate   Float?
  rawLine   String?

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  receipt Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([receiptId])
  @@map("receipt_items")
}

// 添付ファイル（persist.ts の files に対応）
model ReceiptFile {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  receiptId String  @db.Uuid
  page      Int?
  url       String
  mimeType  String?
  width     Int?
  height    Int?
  sha256    String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  receipt Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([receiptId])
  @@map("receipt_files")
}

// カテゴリ
model Category {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String  @db.Uuid
  name       String
  color      String?
  usageCount Int     @default(0)

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  receipts Receipt[]

  @@unique([userId, name])
  @@index([userId])
  @@map("categories")
}
