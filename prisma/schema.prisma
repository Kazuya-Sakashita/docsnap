// Prisma Schema for DocSnap
// レシート・領収書管理アプリのデータベーススキーマ

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =================== Enums ===================
enum AccountType {
  PERSONAL
  BUSINESS
}

enum ReceiptType {
  RECEIPT
  INVOICE
}

enum ReceiptStatus {
  READY
  PROCESSING
  ERROR
  DUPLICATE
}

enum Currency {
  JPY
  USD
  EUR
  OTHER
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  OTHER
}

// =================== Models ===================

// ユーザー
model User {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supabaseUserId String      @unique // ★ 追加（必須）
  email          String      @unique
  name           String?
  accountType    AccountType @default(PERSONAL)
  companyName    String?
  createdAt      DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(6)
  deletedAt      DateTime?   @db.Timestamptz(6)

  receipts   Receipt[]
  categories Category[]

  @@map("users")
}

// レシート/領収書
model Receipt {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String        @db.Uuid
  type         ReceiptType   @default(RECEIPT)
  title        String
  storeName    String
  purchaseDate DateTime      @db.Timestamptz(6)
  currency     Currency      @default(JPY)
  subtotal     Decimal       @db.Decimal(14, 2)
  tax          Decimal       @db.Decimal(14, 2)
  total        Decimal       @db.Decimal(14, 2)
  memo         String?       @db.Text
  status       ReceiptStatus @default(READY)

  // OCR関連
  confidenceScore Float?
  imageUrl        String?
  ocrData         Json?

  // カテゴリ
  categoryId String? @db.Uuid

  // 領収書固有フィールド
  invoiceNumber      String?
  recipientName      String?
  purpose            String?
  registrationNumber String?
  issuerAddress      String?
  paymentDueDate     DateTime?      @db.Timestamptz(6)
  paymentMethod      PaymentMethod?
  taxRate            Decimal?       @db.Decimal(5, 2)

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  items    ReceiptItem[]

  @@index([userId])
  @@index([categoryId])
  @@index([purchaseDate])
  @@index([status])
  @@map("receipts")
}

// 明細
model ReceiptItem {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  receiptId String  @db.Uuid
  name      String
  quantity  Int     @default(1)
  unitPrice Decimal @db.Decimal(14, 2)
  amount    Decimal @db.Decimal(14, 2)

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  receipt Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([receiptId])
  @@map("receipt_items")
}

// カテゴリ
model Category {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String  @db.Uuid
  name       String
  color      String?
  usageCount Int     @default(0)

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  receipts Receipt[]

  @@unique([userId, name])
  @@index([userId])
  @@map("categories")
}
