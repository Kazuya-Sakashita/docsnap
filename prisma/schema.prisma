// Prisma Schema for DocSnap
// レシート・領収書管理アプリのデータベーススキーマ

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ユーザーモデル
model User {
  id          String   @id @default(cuid())
  email       String   @unique
  password    String
  name        String?
  accountType String   @default("PERSONAL") // PERSONAL or BUSINESS
  companyName String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  receipts   Receipt[]
  categories Category[]

  @@map("users")
}

// レシート/領収書モデル
model Receipt {
  id           String   @id @default(cuid())
  userId       String
  type         String   @default("RECEIPT") // RECEIPT or INVOICE
  title        String
  storeName    String
  purchaseDate DateTime
  currency     String   @default("JPY")
  subtotal     Decimal  @db.Decimal(10, 2)
  tax          Decimal  @db.Decimal(10, 2)
  total        Decimal  @db.Decimal(10, 2)
  memo         String?  @db.Text
  status       String   @default("READY") // READY, PROCESSING, ERROR, DUPLICATE
  
  // OCR関連
  confidenceScore Float?
  imageUrl        String?
  ocrData         Json?
  
  // カテゴリ
  categoryId String?
  
  // 領収書固有フィールド
  invoiceNumber      String?
  recipientName      String? // 宛名
  purpose            String? // 但書
  registrationNumber String? // 登録番号（インボイス制度対応）
  issuerAddress      String? // 発行者住所
  paymentDueDate     DateTime? // 支払期日
  paymentMethod      String? // 支払方法
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  items    ReceiptItem[]

  @@index([userId])
  @@index([categoryId])
  @@index([purchaseDate])
  @@index([status])
  @@map("receipts")
}

// レシート明細モデル
model ReceiptItem {
  id        String  @id @default(cuid())
  receiptId String
  name      String
  quantity  Int     @default(1)
  unitPrice Decimal @db.Decimal(10, 2)
  amount    Decimal @db.Decimal(10, 2)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  receipt Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([receiptId])
  @@map("receipt_items")
}

// カテゴリモデル
model Category {
  id         String   @id @default(cuid())
  userId     String
  name       String
  color      String?
  usageCount Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  receipts Receipt[]

  @@unique([userId, name])
  @@index([userId])
  @@map("categories")
}
