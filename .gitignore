# --- Node / Next.js ---
node_modules/
.next/
.next.cache/
.turbo/
out/
.swc/                 # SWC一時キャッシュ
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tsbuildinfo

# --- Env / Secrets ---
.env
.env.*                # .env.local, .env.development など含む
!.env.example         # サンプルはコミット

# 追加：秘密鍵/サービスアカウントの漏れ防止
*.pem
*.key
*.p12
*secret*.json
*service-account*.json
google-credentials.json
gcp-*.json

# --- OS / Editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/**            # VSCode設定をコミットしない場合
!.vscode/settings.json
!.vscode/extensions.json

# --- Lint / Tools Cache ---
.eslintcache
.stylelintcache
.cspellcache
cspell-cache/
*.tgz                 # npm pack等のアーカイブ

# --- Prisma ---
# 生成コード出力先を使う場合のみ
prisma/generated/
# prisma/migrations/ は履歴のためコミット推奨（ignoreしない）

# --- Testing / Coverage ---
coverage/
.nyc_output/

# --- Build / Bundler その他 ---
dist/
build/
.cache/               # 一般的なツールのキャッシュ

# --- Vercel / Deploy ---
.vercel/
.vercel/output/**     # vercel build の出力（必要なら無視）

# --- Misc（一時/ローカル） ---
tmp/
temp/
*.local.*

# --- Local debug artifacts ---
headers.txt
jar.txt
before.jar
