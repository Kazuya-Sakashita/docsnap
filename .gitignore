# --- Node / Next.js ---
node_modules/
.next/
.next.cache/
.turbo/
out/
*.log
npm-debug.log*
yarn-error.log*

# TypeScript build info
*.tsbuildinfo

# --- Env / Secrets ---
.env
.env.*        # .env.local, .env.development など含む
!.env.example # サンプルはコミット

# --- OS / Editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/**        # VSCode設定をコミットしない場合
!.vscode/settings.json
!.vscode/extensions.json

# ESLint / その他キャッシュ
.eslintcache
.stylelintcache
.cspellcache
cspell-cache/

# --- Prisma ---
# 生成物（生成先を作っているなら ignore 推奨）
prisma/generated/

# マイグレーションは原則コミット（履歴）
# prisma/migrations/  ← 追跡したいので ignore しない

# --- Testing / Coverage ---
coverage/
.nyc_output/

# --- Build / Bundler その他 ---
dist/
build/

# --- Vercel / Deploy ---
.vercel/

# --- Misc ---
# 一時ファイル・ローカル用
tmp/
temp/
*.local.*
